{
  "name": "inflow-mcp-server",
  "version": "1.4.0-alpha.2",
  "description": "MCP server for inFlow Inventory API integration",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "inflow-mcp-server": "dist/index.js",
    "inflow-manufacturing-run-coordinator": "dist/runtime/manufacturing-run-launch.js",
    "inflow-manufacturing-run-shadow": "dist/runtime/manufacturing-run-dark.js",
    "manufacturing-run-launch": "dist/runtime/manufacturing-run-launch.js",
    "manufacturing-run-dark": "dist/runtime/manufacturing-run-dark.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:coordinator": "node dist/runtime/manufacturing-run-launch.js",
    "validate:coordinator": "node dist/runtime/manufacturing-run-launch.js --validate-only",
    "start:coordinator:shadow": "node dist/runtime/manufacturing-run-dark.js",
    "dev": "tsc --watch",
    "test": "vitest run src",
    "test:coordinator": "vitest run src/http src/coordinator-http.test.ts src/core/manufacturing-run-store.test.ts src/services/manufacturing-run-coordinator.test.ts",
    "test:watch": "vitest src",
    "test:coverage": "vitest run src --coverage",
    "probe:manufacturing": "node dist/probes/manufacturing-writes.js",
    "probe:manufacturing-pick-batch": "node dist/probes/manufacturing-pick-batch.js",
    "probe:manufacturing-canary": "node dist/runtime/manufacturing-canary-launch.js",
    "probe:domain": "node dist/probes/domain-write-canaries.js",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "inflow",
    "inventory",
    "model-context-protocol"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.2.3",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "4.1.11",
    "typescript": "^7.0.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": "22.x"
  }
}
